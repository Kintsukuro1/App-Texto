{
  "name": "notion-local",
  "private": true,
  "version": "1.0.0",
  "description": "App de escritorio privada y colaborativa para gestión de conocimiento.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "server": "tsx watch server/index.ts",
    "collab": "tsx watch server/collab/index.ts",
    "electron:build-main": "node electron/build.mjs",
    "electron:build-main:watch": "node electron/build.mjs --watch",
    "electron:dev": "concurrently -k -n VITE,MAIN,ELECTRON -c cyan,yellow,green \"vite\" \"node electron/build.mjs --watch\" \"npx wait-on tcp:5173 && npx electron .\"",
    "electron:build": "tsc -b && vite build && node electron/build.mjs && electron-builder",
    "electron:dist": "npm run electron:build"
  },
  "dependencies": {
    "@blocknote/core": "^0.52.1",
    "@blocknote/react": "^0.52.1",
    "@blocknote/shadcn": "^0.52.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@hocuspocus/extension-sqlite": "^4.5.0",
    "@hocuspocus/provider": "^4.5.0",
    "@hocuspocus/server": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fuse.js": "^7.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "ws": "^8.18.0",
    "yjs": "^13.6.32",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.2": true,
    "bcrypt@6.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
